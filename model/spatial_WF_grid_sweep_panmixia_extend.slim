initialize() {

	defineConstant("SIMULATION_AREA", 1);
	defineConstant("POPULATION_SIZE", 10000);
	defineConstant("GRID_SIDE_LENGTH", SIMULATION_AREA/sqrt(POPULATION_SIZE));
	defineCfgParam("fudge_factor", 10); // expectation is 1 selfing by chance per generation, regardless of N, I think?
	
	defineConstant("MUTATION_RATE", 0); // overlay neutral mutations later
	defineConstant("RECOMB_RATE", 1e-8);
	defineGlobal("START_CYCLE", 0);	
	
	initializeSLiMModelType("nonWF");
	
	initializeSLiMOptions(dimensionality="xy", periodicity="xy");
	initializeTreeSeq();

	initializeMutationType("m1", 0, "f", 0); // calculated in first, assigned to tagF
	
	initializeGenomicElementType("g1", m1, 1.0);
	initializeGenomicElement(g1, 0, GENOME_LENGTH - 1);
	initializeMutationRate(MUTATION_RATE);
	initializeRecombinationRate(RECOMB_RATE);
}

function (void) defineCfgParam(string$ name, lifs value) {
    if (!exists(name))
        defineConstant(name, value);
}
2: first() {
	// Store fitness for parent sampling
	inds = p1.individuals;
	counts = inds.countOfMutationsOfType(m1);
	inds[counts == 0].tagF = 1;
	inds[counts == 1].tagF = 1 + (DOMINANCE * SELECTION);
	inds[counts == 2].tagF = 1 + SELECTION;
}
reproduction() {
	potential_parents = p1.individuals;
	n_parent_pairs = POPULATION_SIZE;
	total_parent_pairs = n_parent_pairs + fudge_factor;
	num_draws = total_parent_pairs * 2;
	parents = sample(potential_parents, num_draws, replace = T, weights=potential_parents.tagF); // section 4.2.3
	
	parents1 = parents[seqLen(total_parent_pairs)];
	parents2 = parents[seqLen(total_parent_pairs) + total_parent_pairs];

	selfed = (parents1 == parents2);
// 	catn("selfed pairs = " + sum(selfed));
	parents1 = parents1[!selfed];
	parents2 = parents2[!selfed];
	
	if (size(parents1) < n_parent_pairs) {
		catn("ERROR " + getSeed() + " " + sim.cycle);
		stop("Error - fudge factor needs to be larger");
	}
	parent_index = 0;
	for (i in 0:(sqrt(POPULATION_SIZE) - 1)) { // x axis
		for (j in 0:(sqrt(POPULATION_SIZE) - 1)) { // y axis
			current_offspring_x = runif(1, (i * GRID_SIDE_LENGTH), ((i + 1) * GRID_SIDE_LENGTH));
			current_offspring_y = runif(1, (j * GRID_SIDE_LENGTH), ((j + 1) * GRID_SIDE_LENGTH));
			current_offspring_pos = c(current_offspring_x, current_offspring_y);
			offspring = p1.addCrossed(parents1[parent_index], parents2[parent_index]);
			offspring.setSpatialPosition(current_offspring_pos);
			parent_index = parent_index + 1;
		}
	}
	
	self.active = 0; // callback only called once in a tick, see section 16.3

}
1 early() {
	// initialize population
	
	sim.addSubpop("p1", POPULATION_SIZE);
	p1.setSpatialBounds(c(0, 0, sqrt(SIMULATION_AREA), sqrt(SIMULATION_AREA)));
	pos = c();
	
	for (i in 0:(sqrt(POPULATION_SIZE) - 1)) { // x axis
		for (j in 0:(sqrt(POPULATION_SIZE) - 1)) { // y axis
			pos = c(pos, runif(1, (i*GRID_SIDE_LENGTH), ((i+1)*GRID_SIDE_LENGTH)));
			pos = c(pos, runif(1, (j*GRID_SIDE_LENGTH), ((j+1)*GRID_SIDE_LENGTH)));
		}	
	}
	p1.individuals.setSpatialPosition(pos);
}
2: early() {
	// kill parents
	inds = p1.individuals;
	sim.killIndividuals(inds[inds.age > 0]);
}
1 late() {
	cat("reading from population file..." + START_FILE + "\n");
	sim.readFromPopulationFile(START_FILE);
}
2:1000000000 late() {
	
	if(START_CYCLE == 0) { 
		defineGlobal("START_CYCLE",sim.cycle); 
		catn("simulation start at = " + START_CYCLE);
		sim.treeSeqRememberIndividuals(p1.individuals);	
	} else if(sim.cycle == (START_CYCLE + 100)) {
		catn("saving at = "+ sim.cycle);
		sim.treeSeqRememberIndividuals(p1.individuals);	
	} else if(sim.cycle == (START_CYCLE + 1000)) {
		catn("saving at = " + sim.cycle);
		sim.treeSeqRememberIndividuals(p1.individuals);
// 		catn("saving as: " + OUT_PREFIX + "_1000_extended.trees");
// 		sim.treeSeqOutput(OUT_PREFIX + "_1000_extended.trees");
// 		sim.simulationFinished();
	} else if(sim.cycle == (START_CYCLE + 10000)){
		catn("saving at = " + sim.cycle);
		catn("saving as: " + OUT_PREFIX + "_extended.trees");
		sim.treeSeqOutput(OUT_PREFIX + "_extended.trees");
		sim.simulationFinished();
	}
}


